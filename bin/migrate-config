#!/usr/bin/env python3
"""Convert a project's pre-roles factory.toml to the role grammar, in one reviewed PR (BR-13, BR-14).

Usage: bin/migrate-config <workspace> [--dry-run] [--work-key <KEY>]

Old grammar → `[roles.*]` (lossless: every old value lands under its mapped key, or the script refuses); the old
`[newrelic]` becomes the extension-owned `.compozy/newrelic.toml`. On the operator's terminal it asks for the
promotion approvers (the old GITHUB_APP_PROMOTION_APPROVERS is a write-only secret) and the optional
`[roles.deploy] paths` (the release pipeline's trigger sets, one at a time: includes, then excludes,
comma-separated outside `{}` and `[]`; an empty includes ends the list; none: absent, every train waits for a
Deployment), and refuses on a non-interactive stdin before writing anything (as it does a file `git add` would
skip as ignored: the refusal names the rule). Then it commits both files on a
branch `factory/migrate-roles` from `origin/<base>` in a temporary worktree (the workspace checkout is never
touched), pushes it and opens the PR into `<base>` (protected paths: the operator merges it outside the factory).
Its title is `chore: <KEY> ...` with the work key from --work-key or asked (empty: none, with a note), checked
against the work adapter's key shape (Jira `PROJ-123`); an already open PR keeps its title.
Finally it adds the repository's block to the github-app-review policy working copy and stages it through
bin/stage-policy; nothing is activated (the runbook switches GITHUB_APP_POLICY_DIGEST). It never reads or prints
a secret. A file already in the role grammar is reported `unchanged`.
--dry-run prints the converted files and writes nothing (no prompt, git, GitHub or policy change).
"""
import argparse
import json
import re
import subprocess
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402

BRANCH = "factory/migrate-roles"
REL_TOML, REL_NR = ".compozy/factory/factory.toml", ".compozy/newrelic.toml"
MAPPED = {"repo": {"github", "base", "release", "merge"}, "ci": {"runner"}, "review": {"extension", "repo", "agent"},
          "deploy": {"environment"}, "newrelic": {"account_id", "app_name"}}
FIRST = ("language", "authorization", "team", "runtime")
PR_TITLE = "chore: migrate factory.toml to the role grammar"
PR_BODY = ("Converts `.compozy/factory/factory.toml` to the role grammar (`[roles.*]`) and moves the New Relic "
           "app and account to `.compozy/newrelic.toml`, written by `bin/migrate-config`.\n\n"
           "Both files are protected paths: the factory never merges this PR. Review it and merge it outside "
           "the factory as part of the activation runbook (agents paused).")
HEADER = ("# Factory configuration (role grammar). Migrated by compozy-factory bin/migrate-config; the old\n"
          "# file's comments are in git history. Changes go through PRs (this file is a protected path).\n")


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False).replace("\x7f", "\\u007f")
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{toml_key(k)} = {toml_value(v)}" for k, v in value.items()) + " }" if value else "{}"
    return value.isoformat()  # tomllib dates and times


def toml_key(key):
    return key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key, ensure_ascii=False)


def toml_table(name, table, out):
    """Append the table header with its plain keys, then each nested table under its own dotted header
    (the header is left out when the table only holds tables)."""
    plain = [(k, v) for k, v in table.items() if not isinstance(v, dict)]
    if plain or not table:
        out.append(f"\n[{name}]")
        out += [f"{toml_key(k)} = {toml_value(v)}" for k, v in plain]
    for sub, value in table.items():
        if isinstance(value, dict):
            toml_table(f"{name}.{toml_key(sub)}", value, out)


def dump(conf):
    out = [HEADER.rstrip("\n")]
    out += [f"{toml_key(k)} = {toml_value(v)}" for k, v in conf.items() if not isinstance(v, dict)]
    for name, table in conf.items():
        if name == "roles":
            for role, section in table.items():
                toml_table(f"roles.{role}", section, out)
        elif isinstance(table, dict):
            toml_table(toml_key(name), table, out)
    text = "\n".join(out) + "\n"
    if tomllib.loads(text) != conf:
        raise ValueError("internal: the converted file does not round-trip")
    return text


def refuse_keys(old, section):
    extra = sorted(set(old.get(section, {})) - MAPPED[section])
    if extra:
        fl.refuse(f"old [{section}] {extra[0]} has no place in the role grammar; remove or move it, then re-run")


def convert(old):
    """Old config dict → (new config dict, .compozy/newrelic.toml text, repo, base, release). Refuses what it
    cannot map losslessly."""
    for section in MAPPED:
        if section in old and not isinstance(old[section], dict):
            fl.refuse(f"old [{section}] is not a table")
        refuse_keys(old, section)
    repo, nr, review = old.get("repo", {}), old.get("newrelic", {}), old.get("review", {})
    for key in ("github", "base", "release", "merge"):
        if not repo.get(key):
            fl.refuse(f"old factory.toml missing [repo] {key}")
    if not old.get("ci", {}).get("runner"):
        fl.refuse("old factory.toml missing [ci] runner")
    if not nr.get("app_name"):
        fl.refuse("old factory.toml missing [newrelic] app_name")
    if review.get("extension", "github-app-review") != "github-app-review":
        fl.refuse(f'old [review] extension "{review["extension"]}" has no adapter; only github-app-review migrates')
    if review.get("repo", repo["github"]) != repo["github"]:
        fl.refuse(f'old [review] repo "{review["repo"]}" differs from [repo] github "{repo["github"]}"')
    if review.get("agent", "factory-reviewer") != "factory-reviewer":  # H-4
        print(f'dropped    [review] agent "{review["agent"]}" (BR-16: always factory-reviewer)')
    app, account = nr["app_name"], nr.get("account_id")
    if not isinstance(app, str) or len(app) > 256 or re.search("[\"'\\\\\x00-\x1f\x7f]", app):
        fl.refuse("old [newrelic] app_name must be a string of at most 256 characters without quotes or backslash")
    if account is not None and (type(account) is not int or account <= 0):
        fl.refuse("old [newrelic] account_id must be a positive integer")
    newrelic = f"app = {json.dumps(app)}\n" + (f"account_id = {account}\n" if account is not None else "")

    new = {k: old[k] for k in FIRST if k in old}
    new.update({k: v for k, v in old.items() if k not in FIRST and k not in MAPPED and k != "jira"})
    github = {"repo": repo["github"], "base": repo["base"], "release": repo["release"], "merge": repo["merge"],
              "ci_runner": old["ci"]["runner"]}
    work = {"provider": "jira", "jira": old["jira"]} if "jira" in old else None
    if work is None:
        fl.refuse("old factory.toml has no [jira]; set [roles.work] by hand (work/github: the issue is the work item)")
    deploy = {k: v for k, v in old.get("deploy", {}).items()}
    new["roles"] = {
        "signals": {"provider": ["newrelic"], "newrelic": {"config": REL_NR}},
        "code": {"provider": "github", "github": github},
        "work": work,
        "review": {"provider": "github-app-review", "github-app-review": {}},
        "deploy": {"provider": "github-deployments", "github-deployments": deploy},
    }
    return new, newrelic, repo["github"], repo["base"], repo["release"]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("workspace")
    parser.add_argument("--dry-run", action="store_true", help="print the converted files; write nothing")
    parser.add_argument("--work-key", help="work item key for the PR title (Jira PROJ-123, GitHub #123); asked on "
                                           "the terminal, empty: none")
    args = parser.parse_args()
    root = fl.workspace_root(args.workspace)
    path = root / REL_TOML
    if not path.is_file():
        fl.refuse(f"{path} missing")
    toml_bytes = path.read_bytes()
    try:
        old = tomllib.loads(toml_bytes.decode())
    except (tomllib.TOMLDecodeError, UnicodeDecodeError) as exc:
        fl.refuse(f"{path} invalid TOML ({exc})")
    if not any(section in old for section in fl.OLD_SECTIONS):
        print(f"unchanged  {REL_TOML}")
        return 0
    if "roles" in old:
        fl.refuse(f"{REL_TOML} mixes the old grammar with [roles]; fix it by hand")
    new, nr_text, repo, base, release = convert(old)
    toml_text = dump(new)
    if args.dry_run:
        print(f"--- {REL_TOML}\n{toml_text}--- {REL_NR}\n{nr_text}"
              f"--- policy block for {repo}: delivery_base {base}, promotion {base} -> {release}, "
              f"approvers asked on the real run\n{fl.NO_DEPLOY_PATHS} (asked on the real run)\ndry-run: nothing written")
        return 0
    fl.refuse_ignored(root, base, (REL_TOML, REL_NR), checkout=False)  # S7: it writes only in the PR worktree
    if not sys.stdin.isatty():
        fl.refuse("promotion approvers need an interactive terminal (stdin is not a TTY)")
    print(f"converted  {REL_TOML} ({len([s for s in fl.OLD_SECTIONS if s in old])} sections → [roles.*])")
    print(f"newrelic   {REL_NR} (app, account_id from the old [newrelic])")
    block = fl.policy_block(repo, base, release, fl.ask_approvers(repo))
    paths = fl.ask_deploy_paths()
    if paths:
        new["roles"]["deploy"]["paths"] = paths
        toml_text = dump(new)
    print("\n".join(f"deploy     {text}" if paths else text for text in fl.deploy_paths_lines(paths)))
    title = fl.pr_title(PR_TITLE, fl.work_key(new, args.work_key, True, root))
    print(f"pr         title: {title} (an already open PR keeps its title)")
    if title == PR_TITLE:
        print(fl.NO_WORK_KEY)
    try:
        working, data = fl.plan_policy(repo, block)
    except ValueError as exc:
        fl.refuse(f"policy working copy: {exc}")
    def same_base(wt):
        if (wt / REL_TOML).read_bytes() != toml_bytes:
            fl.refuse(f"the checkout's {REL_TOML} differs from origin/{base}; update the checkout, then re-run")

    fl.publish(root, base, repo, BRANCH, {REL_TOML: toml_text, REL_NR: nr_text}, title, PR_BODY,
               "the reviewer flags the factory.toml change for you", before=same_base)
    if data is None:
        print(f"policy     working copy {working} already has this block for {repo}")
    else:
        fl.write_working_copy(working, data)
        print(f"policy     working copy {working} updated with:")
        print("\n".join("           " + line for line in block.splitlines()))
    stage = subprocess.run([str(Path(__file__).resolve().parent / "stage-policy")], capture_output=True, text=True)
    for line in stage.stdout.splitlines():
        print(f"policy     {line}" if not line.startswith("refused") else line)
    if stage.returncode != 0:
        return 1
    print("policy     not active: the activation runbook switches GITHUB_APP_POLICY_DIGEST (R3)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)
