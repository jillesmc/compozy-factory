#!/usr/bin/env python3
"""Copy agents/factory-* and tools/ into $COMPOZY_HOME (default ~/.compozy).

Usage: bin/install [--dry-run] [--prune]

Writes only $COMPOZY_HOME/agents/factory-* and $COMPOZY_HOME/factory/. Idempotent: an unchanged
file is never rewritten. Prints the approval commands for source scripts and authority blocks
that changed, with the hashes the daemon will demand.
"""
import argparse
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402


def wanted(src, skip_tests=False):
    """Relative path -> source file, skipping caches (and tests for tools/)."""
    files = {}
    for path in sorted(src.rglob("*")):
        rel = path.relative_to(src)
        if path.is_dir() or "__pycache__" in rel.parts or path.suffix == ".pyc":
            continue
        if skip_tests and path.name.startswith("test_"):
            continue
        files[rel] = path
    return files


def plan(files, dest):
    """Return (writes, removals) needed to make dest mirror files."""
    writes = [rel for rel, src in files.items()
              if not (dest / rel).is_file()
              or (dest / rel).read_bytes() != src.read_bytes()
              or (dest / rel).stat().st_mode & 0o777 != src.stat().st_mode & 0o777]
    removals = [p for p in dest.rglob("*") if not p.is_dir() and p.relative_to(dest) not in files] \
        if dest.exists() else []
    return writes, removals


def apply(files, dest, writes, removals):
    for rel in writes:
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(files[rel].read_bytes())
        target.chmod(files[rel].stat().st_mode & 0o777)
    for path in removals:
        path.unlink()
    for path in sorted(dest.rglob("*"), reverse=True):
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()


def symlinks(paths):
    for path in paths:
        if path.is_symlink():
            return path
        if path.is_dir():
            for inner in path.rglob("*"):
                if inner.is_symlink():
                    return inner
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="report without writing")
    parser.add_argument("--prune", action="store_true", help="remove installed factory-* agents no longer in the repo")
    args = parser.parse_args()

    home = fl.compozy_home()
    agents_home, tools_home = home / "agents", home / "factory" / "tools"
    order = {name: i for i, name in enumerate(fl.AGENTS + fl.ON_DEMAND)}
    repo_agents = sorted((p for p in (fl.REPO_ROOT / "agents").glob("factory-*") if p.is_dir()),
                         key=lambda p: (order.get(p.name, len(order)), p.name))
    names = {p.name for p in repo_agents}
    installed = sorted(agents_home.glob("factory-*")) if agents_home.is_dir() else []

    bad = next((p for p in (agents_home, home / "factory") if p.is_symlink()), None) or symlinks(
        [agents_home / p.name for p in repo_agents] + installed + [tools_home])
    if bad:
        fl.refuse(f"{bad} is a symlink (symlink_not_supported)")

    lines, approvals, actions = [], [], []
    for src in repo_agents:
        dest = agents_home / src.name
        files = wanted(src)
        writes, removals = plan(files, dest)
        for rel in writes:
            if rel.parts[0] == "sources" and len(rel.parts) == 2:
                digest = fl.script_hash(files[rel])
                approvals.append(fl.approve_source_command(src.name, rel.name, digest))
        if Path("HEARTBEAT.md") in writes:
            old = (dest / "HEARTBEAT.md").read_text() if (dest / "HEARTBEAT.md").is_file() else ""
            new = fl.authority_digest(files[Path("HEARTBEAT.md")].read_text())
            if new and new != (fl.authority_digest(old) if old else ""):
                approvals.append(fl.approve_authority_command(src.name, new))
        status = "installed" if not dest.exists() else "updated" if writes or removals else "unchanged"
        lines.append(f"{status} {src.name}")
        actions.append((files, dest, writes, removals))

    files = wanted(fl.REPO_ROOT / "tools", skip_tests=True)
    writes, removals = plan(files, tools_home)
    listed = ", ".join(str(rel) for rel in files)
    status = "installed" if not tools_home.exists() else "updated" if writes or removals else "unchanged"
    lines.append(f"{status} tools ({listed})" if status != "unchanged" else "unchanged tools")
    actions.append((files, tools_home, writes, removals))

    stale = [p for p in installed if p.name not in names]
    for path in stale:
        lines.append(f"{'pruned' if args.prune else 'stale'} {path.name}")

    if not args.dry_run:
        for action in actions:
            apply(*action)
        if args.prune:
            for path in stale:
                shutil.rmtree(path)
    print("\n".join(lines))
    if approvals:
        print("approve before attaching:")
        print("\n".join(f"  {cmd}" for cmd in approvals))
    if args.dry_run:
        print("dry-run: nothing written")


if __name__ == "__main__":
    main()
