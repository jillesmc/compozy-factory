#!/usr/bin/env python3
"""Copy agents/factory-*, tools/ and the bundled adapters into $COMPOZY_HOME (default ~/.compozy).

Usage: bin/install [--dry-run] [--prune] [--reconfigure-routing]

Writes only $COMPOZY_HOME/agents/factory-*, $COMPOZY_HOME/skills/factory-<role>-<provider>/ and
$COMPOZY_HOME/factory/. Idempotent: an unchanged file is never rewritten. Prints the approval commands
for source scripts and authority blocks that changed, with the hashes the daemon will demand.

Each adapter skills/factory-<role>-<provider>/ is copied to factory/adapters/<role>-<provider>/ and its
SKILL.md to the user skill root. factory/installed.json records every adapter tree digest and the
factory-reviewer digest read back from the daemon (BR-16): after copying, `compozy agent info
factory-reviewer` is read until it reports a user-level global definition (and, when AGENT.md changed,
a digest other than the pre-install one), for at most 30 s; otherwise install fails and keeps the
previous record.

Provider routing is per machine (S8, BR-R1..R5): $XDG_CONFIG_HOME/compozy-factory/routing.toml (default
~/.config/...), classes work (sentinel, scribe, dispatcher, pr-watcher, gatekeeper), auditor and reviewer,
optional [agents.<name>] overrides. Without the file (or with --reconfigure-routing) install asks on a terminal,
per class, among the authenticated providers of `compozy provider list` (reviewer: the sandboxed reviewer
providers); a class with exactly one candidate uses it with no fallback. No file and no terminal: refused. Every
routed provider must still be listed (reviewer: sandboxed), else refused with its name. The route is rendered
into the installed AGENT.md (provider, model, fallback_chain); the repo copies carry none.
"""
import argparse
import os
import shlex
import shutil
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402


def wanted(src, skip_tests=False):
    """Relative path -> source file, skipping caches (and tests for tools/)."""
    files = {}
    for path in sorted(src.rglob("*")):
        rel = path.relative_to(src)
        if path.is_dir() or "__pycache__" in rel.parts or path.suffix == ".pyc":
            continue
        if skip_tests and path.name.startswith("test_"):
            continue
        files[rel] = path
    return files


def content(src):
    """(bytes, mode) of a source: a file, or (rendered bytes, file the mode comes from)."""
    data, path = src if isinstance(src, tuple) else (src.read_bytes(), src)
    return data, path.stat().st_mode & 0o777


def plan(files, dest):
    """Return (writes, removals) needed to make dest mirror files."""
    writes = [rel for rel, src in files.items()
              if not (dest / rel).is_file()
              or ((dest / rel).read_bytes(), (dest / rel).stat().st_mode & 0o777) != content(src)]
    removals = [p for p in dest.rglob("*") if not p.is_dir() and p.relative_to(dest) not in files] \
        if dest.exists() else []
    return writes, removals


def apply(files, dest, writes, removals):
    for rel in writes:
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        data, mode = content(files[rel])
        target.write_bytes(data)
        target.chmod(mode)
    for path in removals:
        path.unlink()
    for path in sorted(dest.rglob("*"), reverse=True):
        if path.is_dir() and not any(path.iterdir()):
            path.rmdir()


def symlinks(paths):
    for path in paths:
        if path.is_symlink():
            return path
        if path.is_dir():
            for inner in path.rglob("*"):
                if inner.is_symlink():
                    return inner
    return None


def provider_candidates():
    """Class -> providers it may route to, from the daemon's provider list and effective provider config."""
    listed = [p for p in fl.compozy("provider", "list").get("providers", []) if p.get("enabled")]
    config = (fl.compozy("config", "get", "providers") or {}).get("value") or {}
    authenticated = [p["name"] for p in listed if (p.get("auth_status") or {}).get("state") == "authenticated"]
    # Sandboxed reviewer provider (BR-R5): enabled, and the first word of its effective `providers.<name>.command`
    # is exactly $COMPOZY_HOME/extensions/github-app-review/bin/reviewer-sandbox, the extension's wrapper that runs
    # the ACP agent in bubblewrap with no network and egress only through its per-sandbox gateway (the bwrap gateway
    # overlay). claude-reviewer / claude-reviewer-fallback are configured that way; claude-mm1 starts with
    # `env ... npx claude-agent-acp` and is not. A wrapper reached through `env`, a shell or another path does not
    # count: only a direct launch is known to be confined. Their auth state is `unknown` (the sandbox owns its login
    # copy), so they never appear among the authenticated providers.
    sandbox = str(fl.compozy_home() / "extensions" / "github-app-review" / "bin" / "reviewer-sandbox")
    sandboxed = [p["name"] for p in listed if first_word((config.get(p["name"]) or {}).get("command")) == sandbox]
    return {"work": authenticated, "auditor": authenticated, "reviewer": sandboxed}


def first_word(command):
    try:
        return (shlex.split(command) or [""])[0] if isinstance(command, str) else ""
    except ValueError:
        return ""


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        raise fl.Refused("routing: no answer (end of input)") from None


def answer(prompt, default, found, many):
    """[(provider, model)] typed by the operator (empty line: the default)."""
    while True:
        raw = ask(prompt)
        if not raw:
            return default
        if many and raw == "-":
            return []
        pairs = [part.split() for part in raw.split(",")]
        if all(len(p) == 2 and p[0] in found for p in pairs) and (many or len(pairs) == 1):
            return [tuple(p) for p in pairs]
        print(f"  expected {'comma-separated ' if many else ''}<provider> <model>, provider one of: {', '.join(found)}")


def answer_effort(current):
    """The primary's reasoning effort: empty keeps the current value (S8-C3), `-` clears it."""
    while True:
        raw = ask(f"  primary reasoning_effort, - for none [{current or '-'}]: ")
        if not raw:
            return current
        if raw == "-":
            return None
        if fl.ROUTE_WORD.fullmatch(raw):
            return raw
        print("  expected one word, or - for none")


def ask_routing(candidates, old):
    """BR-R3: per class, primary, its reasoning effort, then fallback; defaults from the current file, else
    ROUTING_DEFAULTS. Per-agent overrides are kept as they are."""
    routing = {"agents": (old or {}).get("agents", {})}
    for name, (model, providers) in fl.ROUTING_DEFAULTS.items():
        found, kind = candidates[name], "sandboxed reviewer" if name == "reviewer" else "authenticated"
        current = (old or {}).get(name)
        effort = current["primary"].get("reasoning_effort") if current else None
        if not found:
            raise fl.Refused(f"routing {name}: no {kind} provider in `compozy provider list`")
        if len(found) == 1:
            primary = {"provider": found[0], "model": current["primary"]["model"] if current else model}
            routing[name] = {"primary": {**primary, **({"reasoning_effort": effort} if effort else {})}, "fallback": []}
            print(f"routing {name}: {found[0]} is the only {kind} provider; using it with no fallback")
            continue
        default = ([(current["primary"]["provider"], current["primary"]["model"])]
                   + [(f["provider"], f["model"]) for f in current["fallback"]]
                   if current else [(p, model) for p in providers])
        default = [d for d in default if d[0] in found] or [(found[0], model)]
        print(f"routing {name} ({', '.join(fl.ROUTING_CLASSES[name])}); {kind} providers: {', '.join(found)}")
        (primary,) = answer(f"  primary <provider> <model> [{' '.join(default[0])}]: ", default[:1], found, False)
        effort = answer_effort(effort)
        shown = ", ".join(" ".join(d) for d in default[1:]) or "-"
        chain = answer(f"  fallback, comma-separated <provider> <model> or - for none [{shown}]: ",
                       default[1:], found, True)
        routing[name] = {"primary": {"provider": primary[0], "model": primary[1],
                                     **({"reasoning_effort": effort} if effort else {})},
                         "fallback": [{"provider": p, "model": m} for p, m in chain]}
    return fl.check_routing(routing)


def check_routes(routing, candidates):
    """BR-R3/BR-R5: every routed provider, primary and fallback, is still known; the reviewer's are all sandboxed."""
    for agent in fl.AGENTS + fl.ON_DEMAND:
        name, route = fl.routing_class(agent), fl.agent_route(routing, agent)
        for provider in [route["primary"]["provider"]] + [f["provider"] for f in route["fallback"]]:
            if provider in candidates[name]:
                continue
            if name == "reviewer":
                raise fl.Refused(f"routing {agent}: {provider} is not a sandboxed reviewer provider (primary and "
                                 "every fallback must launch the github-app-review reviewer-sandbox)")
            raise fl.Refused(f"routing {agent}: provider {provider} is not an authenticated provider in "
                             "`compozy provider list`")


def resolve_routing(reconfigure):
    """(routing, asked): the file's routing or the operator's answers; refuses before any write."""
    old = fl.load_routing()  # refuses a symlinked routing.toml or directory first (S8-C4)
    asking = old is None or reconfigure
    if asking and not sys.stdin.isatty():
        raise fl.Refused(fl.NO_ROUTING if old is None else "--reconfigure-routing needs an interactive terminal")
    try:
        candidates = provider_candidates()
    except RuntimeError as exc:
        raise fl.Refused(f"routing: cannot read the providers from the daemon ({exc})") from None
    routing = ask_routing(candidates, old) if asking else old
    check_routes(routing, candidates)
    return routing, asking


def read_back_reviewer(pre, changed):
    """The daemon's semantic definition digest of the just-installed reviewer, or raise RuntimeError."""
    deadline = time.monotonic() + float(os.environ.get("FACTORY_READBACK_TIMEOUT", "30"))
    while True:
        try:
            info = fl.compozy("agent", "info", fl.ON_DEMAND[0])
            digest = info.get("definition_digest")
            if info.get("origin") != "global" or info.get("layer", "user") != "user":
                raise RuntimeError(f"factory-reviewer resolves to origin {info.get('origin')} layer "
                                   f"{info.get('layer')} (expected global, user)")
            if digest and not (changed and digest == pre):
                return digest
            last = f"daemon still reports digest {fl.short(digest)}"
        except RuntimeError as exc:
            if "expected global, user" in str(exc):
                raise
            last = str(exc)
        if time.monotonic() >= deadline:
            raise RuntimeError(f"factory-reviewer digest not read back ({last})")
        time.sleep(0.5)


def reviewer_digest():
    try:
        return fl.compozy("agent", "info", fl.ON_DEMAND[0]).get("definition_digest")
    except RuntimeError:
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true", help="report without writing")
    parser.add_argument("--prune", action="store_true", help="remove installed factory-* agents no longer in the repo")
    parser.add_argument("--reconfigure-routing", action="store_true", help="ask the provider routing again")
    args = parser.parse_args()

    home = fl.compozy_home()
    agents_home, tools_home = home / "agents", home / "factory" / "tools"
    order = {name: i for i, name in enumerate(fl.AGENTS + fl.ON_DEMAND)}
    repo_agents = sorted((p for p in (fl.REPO_ROOT / "agents").glob("factory-*") if p.is_dir()),
                         key=lambda p: (order.get(p.name, len(order)), p.name))
    names = {p.name for p in repo_agents}
    installed = sorted(agents_home.glob("factory-*")) if agents_home.is_dir() else []
    adapters = {(r, p): d for (r, p), d in sorted(fl.bundled_adapters().items())}
    adapter_dests = [(home / "factory" / "adapters" / f"{r}-{p}", home / "skills" / f"factory-{r}-{p}")
                     for r, p in adapters]

    bad = next((p for p in (agents_home, home / "factory", home / "skills") if p.is_symlink()), None) or symlinks(
        [agents_home / p.name for p in repo_agents] + installed + [tools_home]
        + [path for pair in adapter_dests for path in pair])
    if bad:
        fl.refuse(f"{bad} is a symlink (symlink_not_supported)")
    routing, asked = resolve_routing(args.reconfigure_routing)

    lines, approvals, actions = [], [], []
    rendered = {}
    for src in repo_agents:
        dest = agents_home / src.name
        files = wanted(src)
        agent_md = files[Path("AGENT.md")]
        rendered[src.name] = fl.render_agent(agent_md.read_text(), fl.agent_route(routing, src.name)).encode()
        files[Path("AGENT.md")] = (rendered[src.name], agent_md)
        writes, removals = plan(files, dest)
        for rel in writes:
            if rel.parts[0] == "sources" and len(rel.parts) == 2:
                digest = fl.script_hash(files[rel])
                approvals.append(fl.approve_source_command(src.name, rel.name, digest))
        if Path("HEARTBEAT.md") in writes:
            old = (dest / "HEARTBEAT.md").read_text() if (dest / "HEARTBEAT.md").is_file() else ""
            new = fl.authority_digest(files[Path("HEARTBEAT.md")].read_text())
            if new and new != (fl.authority_digest(old) if old else ""):
                approvals.append(fl.approve_authority_command(src.name, new))
        status = "installed" if not dest.exists() else "updated" if writes or removals else "unchanged"
        lines.append(f"{status} {src.name}")
        actions.append((files, dest, writes, removals))

    files = wanted(fl.REPO_ROOT / "tools", skip_tests=True)
    writes, removals = plan(files, tools_home)
    listed = ", ".join(str(rel) for rel in files)
    status = "installed" if not tools_home.exists() else "updated" if writes or removals else "unchanged"
    lines.append(f"{status} tools ({listed})" if status != "unchanged" else "unchanged tools")
    actions.append((files, tools_home, writes, removals))

    record = fl.installed_record(home)
    new_record = {"adapters": {}, "reviewer": record.get("reviewer")}
    for ((role, provider), src), (dest, skill_dest) in zip(adapters.items(), adapter_dests):
        files = wanted(src)
        writes, removals = plan(files, dest)
        skill = {Path("SKILL.md"): src / "SKILL.md"}
        skill_writes, skill_removals = plan(skill, skill_dest)
        tree = fl.tree_digest(src)
        new_record["adapters"][f"{role}-{provider}"] = {"tree": tree, "skill": f"factory-{role}-{provider}"}
        changed = writes or removals or skill_writes or skill_removals
        status = "installed" if not dest.exists() else "updated" if changed else "unchanged"
        lines.append(f"{status} adapter {role}-{provider} tree {fl.short(tree)}")
        actions += [(files, dest, writes, removals), (skill, skill_dest, skill_writes, skill_removals)]

    reviewer_dest = agents_home / fl.ON_DEMAND[0] / "AGENT.md"
    reviewer_changed = not reviewer_dest.is_file() or reviewer_dest.read_bytes() != rendered[fl.ON_DEMAND[0]]
    pre = None
    if not args.dry_run and reviewer_dest.is_file():  # an installed reviewer: its current digest must be known (F-6)
        for _ in range(3):
            pre = reviewer_digest()
            if pre:
                break
            time.sleep(0.5)
        if pre is None and reviewer_changed:
            print("error: cannot read the pre-install factory-reviewer digest from the daemon (is it running?); "
                  "nothing installed, installed.json keeps the previous record")
            sys.exit(1)

    stale = [p for p in installed if p.name not in names]
    for path in stale:
        lines.append(f"{'pruned' if args.prune else 'stale'} {path.name}")

    lines = [f"routing {agent} {fl.route_text(fl.agent_route(routing, agent))}"
             for agent in fl.AGENTS + fl.ON_DEMAND] + lines
    if not args.dry_run:
        if asked:
            fl.write_routing(routing)
            lines.insert(0, f"routing written {fl.routing_path()}")
        for action in actions:
            apply(*action)
        if args.prune:
            for path in stale:
                shutil.rmtree(path)
        try:
            digest = read_back_reviewer(pre, reviewer_changed and pre is not None)
        except RuntimeError as exc:
            print("\n".join(lines))
            print(f"error: {exc}; installed.json keeps the previous record")
            sys.exit(1)
        new_record["reviewer"] = {"definition_digest": digest, "file_sha256": fl.file_sha256(reviewer_dest)}
        if new_record != record:
            fl.write_json(home / "factory" / "installed.json", new_record)
        lines.append(f"reviewer factory-reviewer digest {fl.short(digest)} (origin global, layer user) recorded")
    print("\n".join(lines))
    if approvals:
        print("approve before attaching:")
        print("\n".join(f"  {cmd}" for cmd in approvals))
    if args.dry_run:
        print("dry-run: nothing written")


if __name__ == "__main__":
    try:
        main()
    except fl.Refused as exc:
        fl.refuse(str(exc))
