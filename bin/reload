#!/usr/bin/env python3
"""Recreate always-on instances so the main session loads the current AGENT.md and provider.

Usage: bin/reload <workspace> [agent...]   # no agent = factory.toml [team] agents (default: all six)

`clear-main` is not enough: it keeps the same session id and the provider recorded in it.
Agent memory and approvals (script/authority) belong to the agent definition and stay.
"""
import argparse
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402


def default_agents(workspace):
    path = fl.workspace_root(workspace) / ".compozy" / "factory" / "factory.toml"
    return fl.team(tomllib.loads(path.read_text())) if path.is_file() else fl.AGENTS


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("workspace")
    parser.add_argument("agents", nargs="*")
    args = parser.parse_args()
    ws = args.workspace
    for agent in args.agents or default_agents(ws):
        print(f"== {agent}")
        try:
            fl.compozy("agent", "instance", "archive", agent, "--workspace", ws)
        except RuntimeError:
            print("   (no active instance)")
        fl.compozy("agent", "instance", "create", agent, "--workspace", ws)
        listed = fl.compozy("agent", "instance", "list", "--workspace", ws, "--agent", agent)
        for inst in listed.get("instances", []):
            if inst["agent_name"] == agent and inst.get("state") != "archived":
                print(f"   main: {inst.get('main_session_id')} provider: {inst.get('provider')}")


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)
