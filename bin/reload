#!/usr/bin/env python3
"""Recreate always-on instances so the main session loads the current AGENT.md and provider.

Usage: bin/reload <workspace> [agent...] [--pause]   # no agent = factory.toml [team] agents (default: all six)

First the reviewer guard (`factory_guard.py reviewer`, BR-16): on refusal nothing is archived. On-demand
agents (factory-reviewer) have no instance and are skipped. Each recreated main session gets one boundary
prompt (workaround for compozy/compozy#1815): `boundary <agent> ok`.
--pause pauses each new instance right after `agent instance create`, before its boundary prompt and before
the next agent (`paused <agent>`): a new active instance is due for a check-in at once, so the activation
runbook (R3) recreates the team without any check-in until R5 resumes it. A paused instance's main session
still takes the boundary prompt.

`clear-main` is not enough: it keeps the same session id and the provider recorded in it.
Agent memory and approvals (script/authority) belong to the agent definition and stay.
"""
import argparse
import sys
import tomllib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402


def default_agents(workspace):
    path = fl.workspace_root(workspace) / ".compozy" / "factory" / "factory.toml"
    return fl.team(tomllib.loads(path.read_text())) if path.is_file() else fl.AGENTS


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("workspace")
    parser.add_argument("agents", nargs="*")
    parser.add_argument("--pause", action="store_true", help="pause each new instance before its boundary turn")
    args = parser.parse_args()
    ws = args.workspace
    agents = args.agents or default_agents(ws)
    if any(agent not in fl.ON_DEMAND for agent in agents):
        try:
            print(f"reviewer {fl.reviewer(ws)}")
        except fl.Refused as exc:
            fl.refuse(str(exc))
    failed = False
    for agent in agents:
        if agent in fl.ON_DEMAND:
            print(f"skipped {agent} (on-demand)")
            continue
        print(f"== {agent}")
        try:
            fl.compozy("agent", "instance", "archive", agent, "--workspace", ws)
        except RuntimeError:
            print("   (no active instance)")
        created = fl.compozy("agent", "instance", "create", agent, "--workspace", ws)
        if args.pause:
            fl.compozy("agent", "instance", "pause", created["instance"]["id"], "--workspace", ws)
            print(f"   paused {agent}")
        listed = fl.compozy("agent", "instance", "list", "--workspace", ws, "--agent", agent)
        for inst in listed.get("instances", []):
            if inst["agent_name"] == agent and inst.get("state") != "archived":
                print(f"   main: {inst.get('main_session_id')} provider: {inst.get('provider')}")
        failed |= not fl.boundary(agent, ws, created["instance"])
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)
