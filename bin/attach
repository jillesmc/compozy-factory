#!/usr/bin/env python3
"""Create one always-on instance per factory agent in a workspace.

Usage: bin/attach <workspace> [--agents a,b] [--allow-unsupported-adapter] [--dry-run]

<workspace> is a CompozyOS workspace name, ID or path. Refuses before any CompozyOS call when
<root>/.compozy/factory/factory.toml is missing or invalid (role grammar, adapter schemas, BR-17).
Then, before creating anything: every configured (role, provider) must resolve to an installed adapter
(custom ones through a valid bin/install-adapter binding) whose conformance record matches the
installed tree (BR-11; --allow-unsupported-adapter attaches anyway with a warning), and
factory-reviewer must pass `factory_guard.py reviewer` (BR-16). Agents come from
factory.toml [team] agents (default: all six) unless --agents narrows them. On-demand agents
(factory-reviewer) are never attached: they are reported `skipped <agent> (on-demand)`. An agent whose
source script is not approved is refused with the approve command; the others still attach.
Each new instance's main session gets one boundary prompt (workaround for compozy/compozy#1815: a main
session without a turn is not reopened after a restart): `boundary <agent> ok`. --dry-run runs every
check and prints `would attach <agent>` without creating or prompting anything.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import factorylib as fl  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("workspace")
    parser.add_argument("--agents", help="comma-separated subset of factory agents")
    parser.add_argument("--allow-unsupported-adapter", action="store_true",
                        help="attach even when an adapter has no passing conformance record")
    parser.add_argument("--dry-run", action="store_true", help="run every check; create nothing")
    args = parser.parse_args()

    root = fl.workspace_root(args.workspace)
    _, conf = fl.load_factory_toml(root)
    agents = [a.strip() for a in args.agents.split(",") if a.strip()] if args.agents else fl.team(conf)
    ws = args.workspace
    try:
        for warning in fl.verify_adapters(root, conf, args.allow_unsupported_adapter):
            print(f"warning: {warning}; attaching anyway")
        print(f"reviewer {fl.reviewer(ws)}")
    except fl.Refused as exc:
        fl.refuse(str(exc))

    listed = fl.compozy("agent", "instance", "list", "--workspace", ws, "--limit", "100")
    existing = {i["agent_name"] for i in listed.get("instances", []) if i.get("state") != "archived"}
    refused = False
    for agent in agents:
        if agent in fl.ON_DEMAND:
            print(f"skipped {agent} (on-demand)")
            continue
        if agent in existing:
            print(f"exists {agent}")
            continue
        sources = fl.compozy("agent", "heartbeat", "sources", agent, "--workspace", ws)
        pending = [s for s in sources.get("scripts", []) if not s.get("approved")]
        if pending:
            for script in pending:
                command = fl.approve_source_command(agent, script["name"], script["sha256"])
                print(f"refused: {agent} source {script['name']} not approved; run {command}")
            refused = True
            continue
        if args.dry_run:
            print(f"would attach {agent}")
            continue
        created = fl.compozy("agent", "instance", "create", agent, "--workspace", ws)
        print(f"attached {agent:<20} ({created['instance']['id']})")
        refused |= not fl.boundary(agent, ws, created["instance"])
    sys.exit(1 if refused else 0)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as exc:
        print(f"error: {exc}", file=sys.stderr)
        sys.exit(1)
