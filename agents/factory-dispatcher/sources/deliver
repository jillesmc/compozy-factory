#!/usr/bin/env python3
"""Provider-neutral check-in source: runs the code adapter's `sources/<this file's name>.py`.

The same bytes serve factory-dispatcher/sources/deliver and factory-auditor/sources/due, so one
approval covers every project and code provider. The daemon runs a temporary copy of it with the
workspace root as cwd and a scrubbed environment, so $COMPOZY_HOME is `COMPOZY_HOME` when set, else
~/.compozy (never this file's path), and must hold factory/installed.json.
It reads `[roles.code]` from `.compozy/factory/factory.toml`, resolves the installed adapter
(bundled: $COMPOZY_HOME/factory/adapters/code-<provider>/, checked against installed.json; custom:
the bindings.json entry for this workspace, checked against its source tree) and only then executes
the adapter script with the same stdin and stdout. Any refusal exits 1 with `source_failed: ...`.
"""
import os
import sys
import tomllib
from pathlib import Path

NAME = Path(__file__).name  # the daemon's temporary copy keeps the source's file name
OLD = ("repo", "review", "ci", "deploy", "newrelic", "jira")


def main():
    home = Path(os.environ.get("COMPOZY_HOME") or Path.home() / ".compozy").expanduser()
    if not (home / "factory" / "installed.json").is_file():
        raise RuntimeError(f"{home}/factory/installed.json missing; run bin/install (COMPOZY_HOME or ~/.compozy)")
    sys.path.insert(0, str(home / "factory" / "tools"))
    import factory_guard as guard

    path = Path(".compozy/factory/factory.toml")
    if not path.is_file():
        raise guard.Refused(f"{path} missing")
    conf = tomllib.loads(path.read_text())
    if any(section in conf for section in OLD):
        raise guard.Refused("factory.toml uses the old grammar; run bin/migrate-config <workspace>")
    provider = conf.get("roles", {}).get("code", {}).get("provider")
    if not isinstance(provider, str) or not provider:
        raise guard.Refused("factory.toml missing [roles.code] provider")
    _, installed = guard.resolve(Path.cwd(), "code", provider, conf, home)
    script = installed / "sources" / f"{NAME}.py"
    if not script.is_file():
        raise guard.Refused(f"adapter code/{provider} has no sources/{NAME}.py")
    # -I -B: no script dir or user site on sys.path and no bytecode written (only digested code runs).
    os.execv(sys.executable, [sys.executable, "-I", "-B", str(script)])


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # noqa: BLE001 - the daemon only sees the exit code and stderr
        print(f"source_failed: {exc}", file=sys.stderr)
        sys.exit(1)
